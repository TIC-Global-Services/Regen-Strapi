{
  "kind": "collectionType",
  "collectionName": "redirects",
  "info": {
    "singularName": "redirect",
    "pluralName": "redirects",
    "displayName": "Redirect",
    "description": "Site redirects managed by editors — read by the frontend"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "source": {
      "type": "string",
      "required": true,
      "unique": true,
      "regex": "^/.*"
    },
    "destination": {
      "type": "string",
      "required": true
    },
    "permanent": {
      "type": "boolean",
      "default": true
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "note": {
      "type": "text"
    }
  }
}
